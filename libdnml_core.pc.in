prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libdnml_core
Description: High-performance mathematical and algorithmic library with compile-time dispatching.
Version: @PROJECT_VERSION@
Libs: -L${libdir} -ldnml_core
Cflags: -I${includedir}